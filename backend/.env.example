# ==========================================
# 本番環境 / 開発環境 共通設定
# ==========================================
PORT=5000

# フロントエンドのURL (CORS許可やLINE通知内のリンクに使用)
# PWA_URL=https://contract-approval-sys.vercel.app

# ==========================================
# データベース (Turso)
# ==========================================
# 取得方法: turso db show <db-name> --url
TURSO_DATABASE_URL=libsql://...

# 取得方法: turso db tokens create <db-name>
TURSO_AUTH_TOKEN=ey...

# ==========================================
# ファイルストレージ (Cloudflare R2)
# ==========================================
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=contract-approval-bucket

# ==========================================
# LINE ログイン / 通知
# ==========================================
LINE_CHANNEL_ID=your_channel_id
LINE_CHANNEL_SECRET=your_channel_secret
LINE_CALLBACK_URL=http://localhost:5000/api/line/callback
LINE_MESSAGING_ACCESS_TOKEN=your_messaging_api_token

# ==========================================
# プッシュ通知 (VAPID)
# ==========================================
VAPID_PUBLIC_KEY=your_public_key
VAPID_PRIVATE_KEY=your_private_key
VAPID_SUBJECT=mailto:admin@example.com

# ==========================================
# セキュリティ (JWT)
# ==========================================
JWT_SECRET=your_super_secret_key
JWT_EXPIRES_IN=24h

# ------------------------------------------
# (初回のみ) 以下のフラグをtrueにすると起動時に全ユーザーのパスワードがリセットされます
# リセット後はすぐにコメントアウトしてください
# ------------------------------------------
# RESET_PASSWORDS=true
